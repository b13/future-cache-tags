{
    "name": "b13/future-cache-tags",
    "type": "typo3-cms-extension",
    "description": "Future Cache Tags - Flushes page caches the moment scheduled records go live or expire: remembers the cache tags of every record with a future start or end time and flushes them on time, via CLI worker or Symfony Messenger. For pages, content, news and any other TCA table, workspace-aware.",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3 CMS",
        "cache",
        "cache tags",
        "starttime",
        "endtime",
        "scheduled content",
        "workspaces"
    ],
    "homepage": "https://b13.com",
    "authors": [
        {
            "name": "b13 GmbH",
            "email": "typo3@b13.com",
            "homepage": "https://b13.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/b13/future-cache-tags/issues",
        "source": "https://github.com/b13/future-cache-tags"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.3 || ^15.0",
        "typo3/cms-backend": "^13.4 || ^14.3 || ^15.0"
    },
    "suggest": {
        "typo3/cms-workspaces": "Scheduled records are re-evaluated when workspace changes are published",
        "typo3/cms-scheduler": "Run the cache:future:worker command every minute via the Scheduler"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "typo3/cms-extbase": "^13.4 || ^14.3 || ^15.0",
        "typo3/cms-fluid": "^13.4 || ^14.3 || ^15.0",
        "typo3/cms-frontend": "^13.4 || ^14.3 || ^15.0",
        "typo3/cms-workspaces": "^13.4 || ^14.3 || ^15.0",
        "typo3/coding-standards": "^0.5.5",
        "typo3/testing-framework": "^8.2 || ^9.0 || dev-main"
    },
    "replace": {
        "typo3-ter/future-cache-tags": "self.version"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "B13\\FutureCacheTags\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "B13\\FutureCacheTags\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "future_cache_tags",
            "web-dir": ".Build/Web",
            "app-dir": ".Build",
            "version": "0.1.0",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
